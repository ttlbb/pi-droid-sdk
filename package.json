{
	"name": "pi-droid-sdk",
	"version": "0.1.0",
	"description": "pi provider extension backed by @factory/droid-sdk and Factory Droid models",
	"author": "Ben Tossell",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"factory",
		"droid",
		"droid-sdk",
		"ai",
		"extension"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"USAGE.md"
	],
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"refresh:droid-context-windows": "node scripts/refresh-droid-context-windows.mjs"
	},
	"dependencies": {
		"@factory/droid-sdk": "^0.2.0",
		"zod": "^3.25.76"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=1.4.0",
		"@earendil-works/pi-coding-agent": ">=1.4.0",
		"@earendil-works/pi-tui": ">=1.4.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@earendil-works/pi-tui": "^1.4.0",
		"typebox": "^1.1.38",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
